# Clangd Configuration for MAGDA DAW
# Language server settings for IDE integration

CompileFlags:
  # The live compile database, written by `make debug`. Clangd only looks in the
  # file's own directory, its ancestors, and a `build/` subdirectory of those, so
  # without this it finds nothing here and falls back to guessing flags -- which
  # is why every JUCE and standard-library include showed up as "file not found"
  # in the editor while the same files compiled cleanly.
  #
  # A copy at the repo root would work until it went stale, and one had: it was
  # months behind the build and every file added since was invisible to it.
  # Pointing at the directory CMake writes means there is only ever one.
  CompilationDatabase: cmake-build-debug

  # Treat all files as C++20
  Add:
    - -std=c++20
    - -Wall
    - -Wextra

Index:
  # Index in background without blocking the editor
  Background: Build
  # Don't index standard library (you already know std::, juce::, etc.)
  StandardLibrary: No

Diagnostics:
  # Suppress overly aggressive warnings
  Suppress:
    - readability-make-member-function-const
    - bugprone-narrowing-conversions
    - cppcoreguidelines-narrowing-conversions
    - readability-identifier-length
    - misc-use-internal-linkage
    - cppcoreguidelines-avoid-non-const-global-variables  # TEST_CASE macros
    - readability-identifier-naming  # Don't enforce naming on macros

  # Analyze unused includes (can have false positives with templates/forward declarations)
  UnusedIncludes: Strict

InlayHints:
  # Show type hints
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes

Hover:
  ShowAKA: Yes
